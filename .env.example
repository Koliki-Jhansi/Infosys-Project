# AeroAssist AI - Environment Variables Template
# Copy this file to .env and fill in your credentials if external integrations are desired.

FLASK_SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_PORT=5000

# Decision Gate Threshold (Default 70% = 0.70)
DECISION_THRESHOLD=0.70

# Jira Cloud REST API v3 Integration (Optional)
# Set your Jira Cloud instance credentials to enable automatic issue creation on escalation.
# If left unset or with placeholders, AeroAssist runs in offline mode reporting 'Not Configured'.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

JIRA_PROJECT_KEY=SUP
JIRA_ISSUE_TYPE=KAN

# SMTP Email Integration (Optional)
# Leave blank to run in modular local mode (reports 'Not Configured')
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@aeroassist.ai
SMTP_PASSWORD=your_smtp_app_password_here
SUPPORT_ESCALATION_EMAIL=human-support@aeroassist.ai

