# Aero Assistant - Environment Configuration

# Database
DATABASE_URL=sqlite:///./aero_assistant.db
# For PostgreSQL with pgvector:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aero_assistant

# Security & Authentication
JWT_SECRET_KEY=aero-assistant-insecure-secret-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services Configuration
AI_MOCK_MODE=true
LLM_PROVIDER=openai
LLM_API_KEY=mock-llm-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=mock-embedding-key
EMBEDDING_MODEL=text-embedding-3-small

# Automation & Classification Policies
CONFIDENCE_THRESHOLD=70
MAX_AGENT_REVISION_CYCLES=2

# Jira Cloud Integration
# To connect to your real Atlassian Jira Cloud account:
# 1. Set JIRA_ENABLED=true and JIRA_MOCK_MODE=false
# 2. Set JIRA_BASE_URL to your site, e.g., https://your-domain.atlassian.net
# 3. Set JIRA_EMAIL to your Atlassian account email
# 4. Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# 5. Set JIRA_API_TOKEN to your token
# When JIRA_MOCK_MODE=true, Aero Assistant uses the built-in Jira Cloud REST simulator with zero credentials needed.
JIRA_ENABLED=false
JIRA_MOCK_MODE=true
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=IT
JIRA_DEFAULT_ISSUE_TYPE=Task

# Email / SMTP Service
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@aeroassistant.com
SMTP_USE_TLS=true

# Application
APP_ENV=development
APP_NAME="Aero Assistant"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
PORT=8000
HOST=0.0.0.0

